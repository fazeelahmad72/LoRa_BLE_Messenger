<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_device_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_status_chip"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_bluetooth"
        app:tint="@color/lora_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/deviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/lora_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="TBeam-02" />

        <TextView
            android:id="@+id/deviceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/lora_muted"
            android:textSize="12sp"
            tools:text="AA:BB:CC:DD:EE:FF · -62 dBm" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bindButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bind_device"
        android:textColor="@color/lora_ink"
        app:backgroundTint="@color/lora_accent_soft"
        app:cornerRadius="20dp" />
</LinearLayout>
